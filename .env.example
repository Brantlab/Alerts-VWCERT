BACKEND_PORT=8080
PUBLIC_FRONTEND_ORIGIN=https://alerts.vwcert.org,https://calendar.vwcert.org
CALENDAR_PUBLIC_HOSTS=calendar.vwcert.org

# Leave blank to preserve the alert desk's current browser shared-state writes.
ADMIN_TOKEN=

# Calendar approvals require this separate token. Use a long random value and
# enter it in the calendar approval panel.
CALENDAR_ADMIN_TOKEN=
PRESENCE_TIMEOUT_MS=45000

# Optional if you want Docker Compose to run the tunnel container too.
# If your VPS already runs cloudflared on the host, leave this unset and
# point the tunnel service to http://127.0.0.1:8080.
CLOUDFLARE_TUNNEL_TOKEN=
