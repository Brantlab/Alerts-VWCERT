BACKEND_PORT=8080
PUBLIC_FRONTEND_ORIGIN=https://alerts.vwcert.org

# Leave blank for browser shared-state writes, especially when protected by
# Cloudflare Access. If set, write requests must send Authorization: Bearer.
ADMIN_TOKEN=
PRESENCE_TIMEOUT_MS=45000

# Optional if you want Docker Compose to run the tunnel container too.
# If your VPS already runs cloudflared on the host, leave this unset and
# point the tunnel service to http://127.0.0.1:8080.
CLOUDFLARE_TUNNEL_TOKEN=
